      "item": [
        {
          "id": "732e30d1-7fb6-4c63-916f-6b36493d2c37",
          "name": "Search Vessel by Identifier",
          "request": {
            "name": "Search Vessel by Identifier",
            "description": {
              "content": "Search for a vessel by unique identifier.</br></br> <b>Notes</b> <ul>\n    <li>The <b>frequency of allowed API calls</b> is specific to your API key and is detailed in your contract as a number of successful calls per time period. For example “2 calls per minute”. </br>Regardless of this agreed limit, each API key is technically restricted to a maximum of 100 total (including successful and unsuccessful) requests per minute to ensure system stability.</li>\n</ul>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shipsearch",
                ":api_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "shipid",
                  "value": "<integer>",
                  "description": "(Required) A uniquely assigned ID by MarineTraffic for the subject vessel </br></br> You can <b>instead</b> use  mmsi or imo"
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<integer>",
                  "description": "The Maritime Mobile Service Identity (MMSI) of the vessel you wish to track </br></br> <b>NOTE:</b> Using MMSI may potentially return multiple records as multiple vessels might have transponded the same MMSI"
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<integer>",
                  "description": "The International Maritime Organization (IMO) number of the vessel you wish to track </br></br> <b>NOTE:</b> Using IMO may potentially return multiple records as multiple vessels might have transponded the same IMO"
                },
                {
                  "disabled": false,
                  "key": "shiptype",
                  "value": "<integer>",
                  "description": "Filter data by vessel type: <ul>\n  <li>2: Fishing</li>\n  <li>4: High Speed Craf</li>\n  <li>6: Passenger</li>\n  <li>7: Cargo</li>\n  <li>8: Tanker</li>"
                },
                {
                  "disabled": false,
                  "key": "type_name_id",
                  "value": "<integer>",
                  "description": "Data filter: AIS Shiptype </br></br> Find more information <a href=\"https://support.marinetraffic.com/en/articles/9552866-what-is-the-significance-of-the-ais-shiptype-number\">here</a>"
                },
                {
                  "disabled": false,
                  "key": "protocol",
                  "value": "xml",
                  "description": "Response type. Use one of the following: <ul>\n  <li>xml</li>\n  <li>csv</li>\n  <li>json</li>\n  <li>jsono</li>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "api_key",
                  "description": "(Required) API key: 40-character hexadecimal number"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
