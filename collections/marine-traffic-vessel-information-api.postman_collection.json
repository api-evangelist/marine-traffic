              "body": "[\n  {\n    \"MMSI\": \"string\",\n    \"IMO\": \"string\",\n    \"ENI\": \"string\",\n    \"NAME\": \"string\",\n    \"BUILDER\": \"string\",\n    \"PLACE_OF_BUILD\": \"string\",\n    \"BUILD\": \"string\",\n    \"YARD_NUMBER\": \"string\",\n    \"BREADTH_EXTREME\": \"string\",\n    \"BREADTH_MOULDED\": \"string\",\n    \"DEPTH\": \"string\",\n    \"SUMMER_DWT\": \"string\",\n    \"DISPLACEMENT_SUMMER\": \"string\",\n    \"CALLSIGN\": \"string\",\n    \"FLAG\": \"string\",\n    \"DRAUGHT\": \"string\",\n    \"LENGHT_OVERALL\": \"string\",\n    \"LENGTH_B_W_PERPENDICULARS\": \"string\",\n    \"FUEL_CONSUMPTION\": \"string\",\n    \"SPEED_MAX\": \"string\",\n    \"SPEED_SERVICE\": \"string\",\n    \"TEU\": \"string\",\n    \"GROSS_TONNAGE\": \"string\",\n    \"NET_TONNAGE\": \"string\",\n    \"LIQUID_OIL\": \"string\",\n    \"LIQUID_GAS\": \"string\",\n    \"GRAIN\": \"string\",\n    \"OWNER\": \"string\",\n    \"MANAGER\": \"string\",\n    \"FINANCIAL_OWNER\": \"string\",\n    \"TECHNICAL_MANAGER\": \"string\",\n    \"INSURER\": \"string\",\n    \"VESSEL_TYPE\": \"string\"\n  },\n  {\n    \"MMSI\": \"string\",\n    \"IMO\": \"string\",\n    \"ENI\": \"string\",\n    \"NAME\": \"string\",\n    \"BUILDER\": \"string\",\n    \"PLACE_OF_BUILD\": \"string\",\n    \"BUILD\": \"string\",\n    \"YARD_NUMBER\": \"string\",\n    \"BREADTH_EXTREME\": \"string\",\n    \"BREADTH_MOULDED\": \"string\",\n    \"DEPTH\": \"string\",\n    \"SUMMER_DWT\": \"string\",\n    \"DISPLACEMENT_SUMMER\": \"string\",\n    \"CALLSIGN\": \"string\",\n    \"FLAG\": \"string\",\n    \"DRAUGHT\": \"string\",\n    \"LENGHT_OVERALL\": \"string\",\n    \"LENGTH_B_W_PERPENDICULARS\": \"string\",\n    \"FUEL_CONSUMPTION\": \"string\",\n    \"SPEED_MAX\": \"string\",\n    \"SPEED_SERVICE\": \"string\",\n    \"TEU\": \"string\",\n    \"GROSS_TONNAGE\": \"string\",\n    \"NET_TONNAGE\": \"string\",\n    \"LIQUID_OIL\": \"string\",\n    \"LIQUID_GAS\": \"string\",\n    \"GRAIN\": \"st