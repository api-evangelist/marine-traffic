        {
          "id": "972731cf-32f5-449c-a64b-d623c1f9acef",
          "name": "Berth Calls",
          "request": {
            "name": "Berth Calls",
            "description": {
              "content": "Retrieve arrival and departure information at a specific port, berth or terminal, for a specific period of time. </br></br> <b>Notes</b> <ul>\n    <li>Data is available for dates **after** 2017-07-03</li>\n    <li>Information about <a href=\"https://support.marinetraffic.com/en/articles/9552860-what-kind-of-information-is-ais-transmitted\">AIS-transmitted data</a></li>\n    <li>More information about input parameters: <a href=\"https://support.marinetraffic.com/en/articles/9552918-how-does-marinetraffic-categorise-commercial-market-and-commercial-size-class\">MARKET</a>, <a href=\"https://support.marinetraffic.com/en/articles/9552918-how-does-marinetraffic-categorise-commercial-market-and-commercial-size-class\">SHIPCLASS</a></li>\n    <li>The <b>frequency of allowed API calls</b> is specific to your API key and is detailed in your contract as a number of successful calls per time period. For example “2 calls per minute”. </br>Regardless of this agreed limit, each API key is technically restricted to a maximum of 100 total (including successful and unsuccessful) requests per minute to ensure system stability.</li>\n</ul>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "berth-calls",
                "{{api_key}} "
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "v",
                  "value": "1",
                  "description": "(Required) Version of the service to be executed. Use version 3 to get the latest"
                },
                {
                  "disabled": false,
                  "key": "portid",
                  "value": "<integer>",
                  "description": "(Required) The MarineTraffic ID of the port you wish to monitor (found on the URL of the respective Port page) </br></br> You can <b>instead</b> use port_unlocode, berthid or terminalid"
                },
                {
                  "disabled": false,
                  "key": "port_unlocode",
                  "value": "<integer>",
                  "description": "Port UN LOCODE (without gaps or spaces)"
                },
                {
                  "disabled": false,
                  "key": "berthid",
                  "value": "<integer>",
                  "description": "The MarineTraffic ID of the berth you wish to monitor (list to be provided upon request) "
                },
                {
                  "disabled": false,
                  "key": "terminalid",
                  "value": "<integer>",
                  "description": "The MarineTraffic ID of the terminal you wish to monitor (list to be provided upon request)"
                },
                {
                  "disabled": false,
                  "key": "timespan",
                  "value": "2",
                  "description": "The maximum age, in minutes, of the returned port calls. Maximum value is 2880"
                },
                {
                  "disabled": false,
                  "key": "fromdate",
                  "value": "<dateTime>",
                  "description": "Return Berth Calls where DOCK_TIMESTAMP_UTC is equal to or greater than provided fromdate. Maximum period requested 15 days </br></br> Date format: YYYY-MM-DD HH:MM:SS."
                },
                {
                  "disabled": false,
                  "key": "todate",
                  "value": "<dateTime>",
                  "description": "Return Berth Calls where DOCK_TIMESTAMP_UTC is equal to or less than provided todate. Maximum period requested 15 days </br></br> Date format: YYYY-MM-DD HH:MM:SS"
                },
                {
                  "disabled": false,
                  "key": "market",
                  "value": "<string>",
                  "description": "Define market for which you would like to receive berth calls - <a href=\"https://support.marinetraffic.com/en/articles/9552918-how-does-marinetraffic-categorise-commercial-market-and-commercial-size-class\">more</a> <ul>\n  <li>if undefined and ship-class is also undefined, then return all</li>\n  <li>if undefined and ship-class is defined, return based on ship-class</li>\n  <li>if defined and ship-class is undefined, return all ship-classes of the specific market</li>\n</ul>"
                },
                {
                  "disabled": false,
                  "key": "shipclass",
                  "value": "<integer>",
                  "description": "Define ship class of interest - <a href=\"https://support.marinetraffic.com/en/articles/9552918-how-does-marinetraffic-categorise-commercial-market-and-commercial-size-class\">more</a>"
                },
                {
                  "disabled": false,
                  "key": "dwt_min",
                  "value": "<integer>",
                  "description": "Data filter: minimum DWT </br></br> Use it to filter by size Cargo and Tanker IMO-having vessels (shiptype = 7,8)"
                },
                {
                  "disabled": false,
                  "key": "dwt_max",
                  "value": "<integer>",
                  "description": "Data filter: maximum DWT </br></br> Use it to filter by size Cargo and Tanker IMO-having vessels (shiptype = 7,8)"
                },
                {
                  "disabled": false,
                  "key": "gt_min",
                  "value": "<integer>",
                  "description": "Data filter: minimum GT </br></br> Applicable to IMO-having vessels"
                },
                {
                  "disabled": false,
                  "key": "gt_max",
                  "value": "<integer>",
                  "description": "Data filter: maximum GT </br></br> Applicable to IMO-having vessels"
                },
                {
                  "disabled": false,
                  "key": "movetype",
                  "value": "<integer>",
                  "description": "Use 0 to include both, 1 to only receive dockings or 2 for only undockings within the defined period. If not used, only dockings are returned </br></br> <b>Available only from version 2 of the service</b>"
                },
                {
                  "disabled": false,
                  "key": "protocol",
                  "value": "xml",
                  "description": "Response type. Use one of the following: <ul>\n  <li>xml</li>\n  <li>csv</li>\n  <li>jsono</li>"
                },
                {
                  "disabled": false,
                  "key": "msgtype",
                  "value": "simple",
                  "description": "Resolution of the response. Available values: <ul>\n  <li>simple</li>\n  <li>extended</li>\n</ul> If used with the value <b>extended</b>, the response includes voyage related data since the previous port call"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
